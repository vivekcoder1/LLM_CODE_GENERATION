# Copy these keys into knowledge_context/.env and enter the intended domain-graph credentials.
# The constructor reads only that file unless --env-file explicitly selects another one.
# Root .env and inherited NEO4J_* settings are ignored. Values must be literal.
NEO4J_URI=neo4j+s://YOUR-DOMAIN-GRAPH-INSTANCE.databases.neo4j.io
NEO4J_USER=YOUR-USER
NEO4J_PASSWORD=YOUR-PASSWORD
# Optional: omit to use the selected server's default database.
# NEO4J_DATABASE=your_database_name
