      "source": "test_burgers2d/burgers2d_ground_truth.py",
      "note": "knowledge_context/domains/burgers2d.md",
      "bindings": [], "helpers": [],
      "fields": [
        {"id": "velocity", "variable": "v0", "aliases": ["v0", "v"], "role": "velocity", "representation": "centered_vector_grid"}
      ],
      "update_scope": "function:step",
      "steps": [
        {"id": "diffusion", "name": "Implicit diffusion", "code": "v = diffuse.implicit(v, 0.1, dt=dt)"},
        {"id": "self_advection", "name": "Self-advection of diffused velocity", "code": "v = advect.semi_lagrangian(v, v, dt=dt)"}
      ],
      "outputs": [
        {"id": "velocity_trajectory", "variable": "v_trj", "code": "v_trj = iterate(step, batch(time=100), v0)", "axis_order": ["time", "x", "y", "vector"], "initial_frame": "library_default", "artifacts": ["test_burgers2d/burgers2d_ground_truth.npy", "test_burgers2d/burgers2d_ground_truth_trj.npy"]}
